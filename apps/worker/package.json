{
	"name": "@knowledgeprism/worker",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"lint:type": "npx tsc --noEmit",
		"lint:js": "npx eslint . --max-warnings=0",
		"lint": "concurrently \"npm:lint:*\"",
		"start:dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:copy",
		"build:copy": "cp -r package.json build",
		"start": "node ./src/index.js"
	},
	"devDependencies": {
		"tsx": "4.23.1"
	},
	"dependencies": {
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"@knowledgeprism/config": "*",
		"dotenv": "17.4.2",
		"@aws-sdk/client-bedrock-runtime": "3.1120.0",
		"@aws-sdk/client-s3": "3.1120.0"
	}
}
